{
  "expo": {
    "name": "CzechPal",
    "slug": "czechpal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "czechpal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "bundleIdentifier": "com.czechpal.app",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1",
              "0A2A.1",
              "3B52.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1",
              "85F4.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.czechpal.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F4F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0A0C10",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "color": "#2251D1"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CzechPal shows where you are on the Explore map, so you can find parks and viewpoints near you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "motionUsagePermission": false,
          "locationFullAccuracyPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CzechPal opens your photos so you can explain a picture of Czech text you took earlier.",
          "cameraPermission": "CzechPal uses the camera to read Czech text you point it at.",
          "microphonePermission": "CzechPal records you speaking Czech so you can play it back when you practise for the A2 exam. Recordings stay on your phone."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CzechPal uses the camera to read Czech text you point it at.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false,
          "microphonePermission": "CzechPal records you speaking Czech so you can play it back when you practise for the A2 exam. Recordings stay on your phone."
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 1,
              "supportsFileWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*",
              "image/*",
              "application/pdf"
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "CzechPal records you speaking Czech so you can play it back when you practise for the A2 exam. Recordings stay on your phone.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "com.czechpal.app.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.czechpal.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "1b1f6a7c-0a90-4ea5-b290-2831e4401ba3"
      }
    },
    "owner": "govinfloyd"
  }
}
